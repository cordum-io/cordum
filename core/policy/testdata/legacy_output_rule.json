{
  "ID": "legacy-output-pii-redact",
  "Enabled": true,
  "Severity": "high",
  "Desc": "Redact PII in outputs",
  "Match": {
    "Tenants": [
      "acme"
    ],
    "Topics": [
      "job.acme.*"
    ],
    "Capabilities": [
      "llm.request"
    ],
    "RiskTags": [
      "contains_pii"
    ],
    "Scanners": [
      "pii"
    ],
    "ContentPatterns": [
      "(?i)\\bSSN\\b"
    ],
    "Keywords": [
      "social",
      "ssn"
    ],
    "ContentTypes": [
      "application/json"
    ],
    "Detectors": [
      "pii"
    ],
    "OutputSizeGt": 0,
    "MaxOutputBytes": 4194304,
    "HasError": false
  },
  "Decision": "redact",
  "Reason": "pii_in_output"
}
