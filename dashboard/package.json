    "jsdom": "^29.1.1",
    "knip": "^6.41.0",
    "msw": "^2.15.0",
    "orval": "^8",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
